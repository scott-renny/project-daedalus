{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/scott-renny/project-daedalus/schemas/certification-lifecycle/renewal-rule.schema.json",
  "title": "Certification Renewal Rule",
  "description": "Versioned renewal requirements verified against an authoritative vendor source.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "rule_id",
    "vendor",
    "certification_name",
    "renewal_methods",
    "source_url",
    "verified_at"
  ],
  "properties": {
    "rule_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "vendor": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "certification_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 150
    },
    "validity_months": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "renewal_window_days": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "renewal_methods": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "continuing_education",
          "exam",
          "approved_course",
          "renewal_fee",
          "vendor_program",
          "no_renewal_required",
          "other"
        ]
      }
    },
    "ce_credits_required": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "renewal_fee_amount": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "renewal_fee_currency": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[A-Z]{3}$"
    },
    "effective_from": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "source_url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "verified_at": {
      "type": "string",
      "format": "date-time"
    },
    "notes": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 2000
    }
  }
}
